---
interface Props {
  id: string;
  label?: string;
  text: string;
  placement?: 'top' | 'bottom' | 'left' | 'right';
  /** Larger glass-styled dot for FAB control groups */
  variant?: 'default' | 'fab';
}

const { id, label = 'Nota de revisión', text, placement = 'top', variant = 'default' } = Astro.props;
---

<span
  class:list={['review-hint', `review-hint--${placement}`, variant === 'fab' && 'review-hint--fab']}
  data-review-hint={id}
  data-placement={placement}
>
  <button
    type="button"
    class="review-hint__dot"
    aria-expanded="false"
    aria-controls={`review-hint-tip-${id}`}
    title={label}
  >
    <span class="sr-only">{label}</span>
    i
  </button>
  <span id={`review-hint-tip-${id}`} class="review-hint__tip" role="tooltip" hidden>
    <span class="review-hint__label">{label}</span>
    <span class="review-hint__text">{text}</span>
    <button type="button" class="review-hint__dismiss" data-review-dismiss aria-label="Cerrar nota">
      Entendido
    </button>
  </span>
</span>

<style>
  .review-hint {
    position: relative;
    display: inline-flex;
    align-items: center;
    vertical-align: middle;
    margin-left: 0.35rem;
    z-index: 1;
  }

  .review-hint.is-open {
    z-index: 90;
  }

  .review-hint__dot {
    width: 1.15rem;
    height: 1.15rem;
    border-radius: 50%;
    border: 1px solid rgba(232, 232, 232, 0.35);
    background: rgba(0, 0, 0, 0.45);
    color: var(--chrome-2);
    font-family: var(--font-display);
    font-size: 0.62rem;
    line-height: 1;
    cursor: pointer;
    opacity: 0.72;
    flex-shrink: 0;
    transition: opacity 0.2s ease, border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
  }

  .review-hint--fab {
    margin-left: 0;
  }

  .review-hint--fab .review-hint__dot {
    width: 1.45rem;
    height: 1.45rem;
    font-size: 0.7rem;
    opacity: 0.95;
    border-color: rgba(232, 232, 232, 0.4);
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(8px);
  }

  .review-hint__dot:hover,
  .review-hint__dot[aria-expanded='true'] {
    opacity: 1;
    border-color: rgba(196, 16, 16, 0.7);
    color: #fff;
  }

  .review-hint__tip {
    position: fixed;
    z-index: 90;
    width: min(260px, calc(100vw - 1.5rem));
    padding: 0.75rem 0.85rem;
    border-radius: 12px;
    border: 1px solid rgba(232, 232, 232, 0.22);
    background: linear-gradient(160deg, rgba(18, 18, 18, 0.98), rgba(50, 0, 0, 0.92));
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.55);
    display: grid;
    gap: 0.35rem;
    pointer-events: auto;
  }

  .review-hint__tip[hidden] {
    display: none !important;
  }

  .review-hint__label {
    font-family: var(--font-display);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--red-bright);
  }

  .review-hint__text {
    color: #d8d8d8;
    font-size: 0.78rem;
    line-height: 1.4;
  }

  .review-hint__dismiss {
    justify-self: start;
    margin-top: 0.15rem;
    border: 0;
    background: transparent;
    color: var(--chrome-2);
    font-size: 0.72rem;
    text-decoration: underline;
    cursor: pointer;
    padding: 0;
  }
</style>

<script>
  const STORAGE_KEY = 'vd-review-hints-dismissed';
  const GAP = 10;
  const VIEW_PAD = 12;

  function readDismissed(): Set<string> {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return new Set();
      return new Set(JSON.parse(raw) as string[]);
    } catch {
      return new Set();
    }
  }

  function writeDismissed(set: Set<string>) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify([...set]));
  }

  function clamp(n: number, min: number, max: number) {
    return Math.min(max, Math.max(min, n));
  }

  /** Position tip in viewport coords so stacking contexts / overflow never clip it. */
  function placeTip(dot: HTMLElement, tip: HTMLElement, placement: string) {
    const rect = dot.getBoundingClientRect();
    const tipRect = tip.getBoundingClientRect();
    const vw = window.innerWidth;
    const vh = window.innerHeight;
    const maxLeft = vw - tipRect.width - VIEW_PAD;
    const maxTop = vh - tipRect.height - VIEW_PAD;

    let left = 0;
    let top = 0;

    switch (placement) {
      case 'bottom':
        left = rect.left + rect.width / 2 - tipRect.width / 2;
        top = rect.bottom + GAP;
        break;
      case 'left':
        left = rect.left - tipRect.width - GAP;
        top = rect.top + rect.height / 2 - tipRect.height / 2;
        break;
      case 'right':
        left = rect.right + GAP;
        top = rect.top + rect.height / 2 - tipRect.height / 2;
        break;
      case 'top':
      default:
        left = rect.left + rect.width / 2 - tipRect.width / 2;
        top = rect.top - tipRect.height - GAP;
        break;
    }

    // Keep readable inside the viewport; prefer flipping when the preferred side overflows.
    if (placement === 'top' && top < VIEW_PAD) {
      top = rect.bottom + GAP;
    } else if (placement === 'bottom' && top + tipRect.height > vh - VIEW_PAD) {
      top = rect.top - tipRect.height - GAP;
    } else if (placement === 'left' && left < VIEW_PAD) {
      left = rect.right + GAP;
    } else if (placement === 'right' && left + tipRect.width > vw - VIEW_PAD) {
      left = rect.left - tipRect.width - GAP;
    }

    tip.style.left = `${clamp(left, VIEW_PAD, Math.max(VIEW_PAD, maxLeft))}px`;
    tip.style.top = `${clamp(top, VIEW_PAD, Math.max(VIEW_PAD, maxTop))}px`;
  }

  type TipEntry = {
    root: HTMLElement;
    tip: HTMLElement;
    dot: HTMLElement;
    placement: string;
    home: Node | null;
  };

  const dismissed = readDismissed();
  const openTips = new Set<TipEntry>();

  function restoreTip(entry: TipEntry) {
    entry.tip.hidden = true;
    entry.tip.style.left = '';
    entry.tip.style.top = '';
    if (entry.home && entry.tip.parentNode !== entry.home) {
      entry.home.appendChild(entry.tip);
    }
    entry.dot.setAttribute('aria-expanded', 'false');
    entry.root.classList.remove('is-open');
    openTips.delete(entry);
  }

  function closeAll(except?: TipEntry) {
    [...openTips].forEach((entry) => {
      if (entry !== except) restoreTip(entry);
    });
  }

  function repositionOpen() {
    openTips.forEach(({ tip, dot, placement }) => {
      if (!tip.hidden) placeTip(dot, tip, placement);
    });
  }

  window.addEventListener('scroll', repositionOpen, { passive: true, capture: true });
  window.addEventListener('resize', repositionOpen);

  document.querySelectorAll<HTMLElement>('[data-review-hint]').forEach((root) => {
    const id = root.dataset.reviewHint;
    if (!id) return;
    if (dismissed.has(id)) {
      root.hidden = true;
      return;
    }

    const dot = root.querySelector<HTMLButtonElement>('.review-hint__dot');
    const tip = root.querySelector<HTMLElement>('.review-hint__tip');
    const dismissBtn = root.querySelector<HTMLButtonElement>('[data-review-dismiss]');
    const placement = root.dataset.placement || 'top';
    if (!dot || !tip || !dismissBtn) return;

    const entry: TipEntry = { root, tip, dot, placement, home: tip.parentNode };

    const close = () => restoreTip(entry);

    const open = () => {
      closeAll(entry);

      // Portal to body so transform/backdrop-filter ancestors cannot trap fixed tips.
      document.body.appendChild(tip);
      tip.hidden = false;
      tip.style.left = '0px';
      tip.style.top = '0px';
      placeTip(dot, tip, placement);
      dot.setAttribute('aria-expanded', 'true');
      root.classList.add('is-open');
      openTips.add(entry);
    };

    dot.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      if (openTips.has(entry)) close();
      else open();
    });

    dismissBtn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      dismissed.add(id);
      writeDismissed(dismissed);
      close();
      root.hidden = true;
    });
  });

  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    [...openTips].forEach((entry) => {
      if (entry.root.contains(target) || entry.tip.contains(target)) return;
      restoreTip(entry);
    });
  });
</script>
