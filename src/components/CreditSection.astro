---
import ReviewHint from './ReviewHint.astro';
import { COMUNAS_RM } from '../data/comunas';
import { withBase } from '../scripts/utils';

const base = import.meta.env.BASE_URL;
const flotaHref = withBase('/#flota', base);
---

<section id="credito" class="section credit" data-speed-enter aria-labelledby="credito-title">
  <div class="credit__glow" aria-hidden="true"></div>
  <div class="container credit__layout">
    <div class="credit__copy reveal">
      <p class="section-kicker">Financiamiento</p>
      <div class="section-heading">
        <h1 id="credito-title" class="section-title credit__title">
          Te aprobamos tu crédito automotriz en 5 minutos
        </h1>
        <ReviewHint
          id="credito-demo"
          placement="right"
          label="Nota de revisión"
          text="Este formulario simula una preaprobación para la revisión del sitio. No envía datos a un banco ni genera una evaluación real."
        />
      </div>
      <p class="section-lead">
        Completa tus datos y simulamos una preaprobación de crédito para la unidad que te interesa.
        En producción, un ejecutivo te contactaría con las condiciones; aquí el flujo es solo demostrativo.
      </p>

      <ol class="credit__steps">
        <li>
          <span class="credit__step-n">01</span>
          <div>
            <strong>Ingresas tus datos</strong>
            <p>Nombre, RUT, correo y domicilio para identificar la solicitud.</p>
          </div>
        </li>
        <li>
          <span class="credit__step-n">02</span>
          <div>
            <strong>Revisamos la solicitud</strong>
            <p>En esta demo la evaluación es instantánea y no consulta burós reales.</p>
          </div>
        </li>
        <li>
          <span class="credit__step-n">03</span>
          <div>
            <strong>Te contactamos</strong>
            <p>Un asesor te orienta sobre montos, cuotas y unidades disponibles.</p>
          </div>
        </li>
      </ol>
    </div>

    <div class="credit__panel glass reveal" data-credit-panel>
      <form class="credit-form" data-credit-form novalidate>
        <p class="credit-form__eyebrow">Preaprobación</p>
        <p class="credit-form__intro">Todos los campos son obligatorios. Respuesta simulada en segundos.</p>

        <div class="credit-form__grid">
          <div class="credit-field" data-field>
            <label for="credito-nombre">Nombre completo</label>
            <input
              id="credito-nombre"
              name="nombre"
              type="text"
              autocomplete="name"
              placeholder="Ej. Camila Rojas Pérez"
              required
            />
            <p class="credit-field__error" data-field-error hidden></p>
          </div>

          <div class="credit-field" data-field>
            <label for="credito-rut">RUT</label>
            <input
              id="credito-rut"
              name="rut"
              type="text"
              inputmode="text"
              autocomplete="off"
              placeholder="12.345.678-5"
              maxlength="12"
              required
            />
            <p class="credit-field__error" data-field-error hidden></p>
          </div>

          <div class="credit-field" data-field>
            <label for="credito-nacimiento">Fecha de nacimiento</label>
            <input id="credito-nacimiento" name="nacimiento" type="date" required />
            <p class="credit-field__error" data-field-error hidden></p>
          </div>

          <div class="credit-field" data-field>
            <label for="credito-email">Correo electrónico</label>
            <input
              id="credito-email"
              name="email"
              type="email"
              autocomplete="email"
              placeholder="nombre@correo.cl"
              required
            />
            <p class="credit-field__error" data-field-error hidden></p>
          </div>

          <div class="credit-field" data-field>
            <label for="credito-comuna">Comuna</label>
            <select id="credito-comuna" name="comuna" required>
              <option value="" disabled selected>Selecciona tu comuna</option>
              {COMUNAS_RM.map((comuna) => <option value={comuna}>{comuna}</option>)}
            </select>
            <p class="credit-field__error" data-field-error hidden></p>
          </div>

          <div class="credit-field credit-field--full" data-field>
            <label for="credito-direccion">Dirección</label>
            <input
              id="credito-direccion"
              name="direccion"
              type="text"
              autocomplete="street-address"
              placeholder="Calle, número, depto u oficina"
              required
            />
            <p class="credit-field__error" data-field-error hidden></p>
          </div>
        </div>

        <button class="btn btn-primary credit-form__submit" type="submit" data-credit-submit>
          Simular preaprobación
        </button>
        <p class="credit-form__note">
          Al enviar aceptas que un asesor de Valentino Dolusan pueda contactarte. Sin backend real en esta revisión.
        </p>
      </form>

      <div
        class="credit-success"
        data-credit-success
        hidden
        tabindex="-1"
        role="status"
        aria-live="polite"
      >
        <p class="credit-success__kicker">Solicitud recibida</p>
        <h2 class="credit-success__title">Gracias. Te contactamos a la brevedad</h2>
        <p class="credit-success__text">
          Registramos tu preaprobación de demostración. En la versión final, un ejecutivo confirmaría
          condiciones y siguientes pasos por correo o teléfono.
        </p>
        <a class="btn btn-ghost" href={flotaHref}>Volver a la flota</a>
      </div>
    </div>
  </div>
</section>

<style>
  .credit {
    overflow: visible;
  }

  .credit__glow {
    position: absolute;
    inset: 10% auto auto 50%;
    width: min(720px, 90vw);
    height: 420px;
    transform: translateX(-50%);
    background:
      radial-gradient(ellipse at center, rgba(196, 16, 16, 0.28), transparent 68%),
      radial-gradient(ellipse at 30% 40%, rgba(255, 255, 255, 0.06), transparent 55%);
    pointer-events: none;
    z-index: 0;
  }

  .credit__layout {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: clamp(1.5rem, 4vw, 2.75rem);
    align-items: start;
  }

  .credit__title {
    max-width: 18ch;
  }

  .credit__steps {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .credit__steps li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.85rem;
    align-items: start;
  }

  .credit__step-n {
    font-family: var(--font-display);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--red-bright);
    padding-top: 0.2rem;
  }

  .credit__steps strong {
    display: block;
    font-family: var(--font-display);
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 0.25rem;
  }

  .credit__steps p {
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .credit__panel {
    padding: clamp(1.25rem, 3vw, 1.75rem);
    overflow: visible;
  }

  .credit-form__eyebrow {
    font-family: var(--font-display);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--red-bright);
    margin-bottom: 0.35rem;
  }

  .credit-form__intro {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 1.25rem;
  }

  .credit-form__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem 0.85rem;
  }

  .credit-field {
    display: grid;
    gap: 0.35rem;
  }

  .credit-field--full {
    grid-column: 1 / -1;
  }

  .credit-field label {
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--chrome-2);
  }

  .credit-field input,
  .credit-field select {
    width: 100%;
    min-height: 46px;
    border-radius: 12px;
    border: 1px solid rgba(232, 232, 232, 0.22);
    background: rgba(0, 0, 0, 0.42);
    padding: 0.65rem 0.85rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .credit-field input::placeholder {
    color: rgba(168, 168, 168, 0.75);
  }

  .credit-field select {
    appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, var(--chrome-2) 50%),
      linear-gradient(135deg, var(--chrome-2) 50%, transparent 50%);
    background-position:
      calc(100% - 18px) calc(50% - 3px),
      calc(100% - 12px) calc(50% - 3px);
    background-size: 6px 6px;
    background-repeat: no-repeat;
    padding-right: 2rem;
  }

  .credit-field input:focus,
  .credit-field select:focus {
    outline: none;
    border-color: rgba(196, 16, 16, 0.75);
    box-shadow: 0 0 0 3px rgba(196, 16, 16, 0.18);
  }

  .credit-field.is-invalid input,
  .credit-field.is-invalid select {
    border-color: rgba(196, 16, 16, 0.85);
  }

  .credit-field__error {
    margin: 0;
    color: #ffb4b4;
    font-size: 0.74rem;
    line-height: 1.35;
  }

  .credit-form__submit {
    width: 100%;
    margin-top: 1.15rem;
  }

  .credit-form__submit[data-loading='1'] {
    opacity: 0.85;
    pointer-events: none;
  }

  .credit-form__note {
    margin-top: 0.75rem;
    color: var(--text-muted);
    font-size: 0.78rem;
    line-height: 1.4;
  }

  .credit-success {
    display: grid;
    gap: 0.75rem;
    padding: 0.35rem 0.15rem;
  }

  .credit-success[hidden] {
    display: none !important;
  }

  .credit-success__kicker {
    font-family: var(--font-display);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--red-bright);
  }

  .credit-success__title {
    font-size: clamp(1.15rem, 2.4vw, 1.45rem);
  }

  .credit-success__text {
    color: var(--text-muted);
    font-size: 0.95rem;
    max-width: 36ch;
  }

  .credit-success .btn {
    justify-self: start;
    margin-top: 0.5rem;
  }

  @media (max-width: 900px) {
    .credit__layout,
    .credit-form__grid {
      grid-template-columns: 1fr;
    }

    .credit__title {
      max-width: none;
    }
  }
</style>

<script>
  import { initCreditForm } from '../scripts/credit-form.ts';
  initCreditForm();
</script>
