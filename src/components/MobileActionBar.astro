---
import { withBase } from '../scripts/utils';

const base = import.meta.env.BASE_URL;
const creditoHref = withBase('/credito/', base);
const venderHref = withBase('/vender/', base);
---

<nav class="mobile-action-bar" aria-label="Acciones rápidas">
  <a class="mobile-action-bar__btn mobile-action-bar__btn--primary" href={creditoHref}>
    Obtén tu crédito en 5 minutos
  </a>
  <a class="mobile-action-bar__btn mobile-action-bar__btn--ghost" href={venderHref}>
    Deja tu vehículo a consignación
  </a>
</nav>

<style>
  .mobile-action-bar {
    display: none;
  }

  @media (max-width: 720px) {
    .mobile-action-bar {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 55;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.55rem;
      padding: 0.65rem 0.75rem calc(0.65rem + env(safe-area-inset-bottom, 0px));
      background: linear-gradient(
        180deg,
        rgba(5, 5, 5, 0.35) 0%,
        rgba(5, 5, 5, 0.88) 28%,
        rgba(8, 8, 8, 0.96) 100%
      );
      border-top: 1px solid rgba(232, 232, 232, 0.22);
      backdrop-filter: blur(18px) saturate(140%);
      -webkit-backdrop-filter: blur(18px) saturate(140%);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.1),
        0 -12px 36px rgba(0, 0, 0, 0.45);
    }

    .mobile-action-bar__btn {
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      min-height: 52px;
      padding: 0.55rem 0.6rem;
      border-radius: 14px;
      font-family: var(--font-display);
      font-size: 0.62rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      line-height: 1.25;
      text-transform: none;
      transition:
        transform 0.2s var(--ease-out),
        background 0.2s ease,
        border-color 0.2s ease,
        box-shadow 0.2s ease;
    }

    .mobile-action-bar__btn:active {
      transform: scale(0.98);
    }

    .mobile-action-bar__btn--primary {
      background: linear-gradient(135deg, var(--red-bright), var(--red-deep));
      color: #fff;
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: 0 8px 22px rgba(155, 0, 0, 0.4);
    }

    .mobile-action-bar__btn--ghost {
      background: linear-gradient(145deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.03));
      color: var(--chrome-1);
      border: 1px solid rgba(232, 232, 232, 0.38);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12);
    }
  }

  @media (max-width: 720px) and (prefers-reduced-motion: reduce) {
    .mobile-action-bar__btn:active {
      transform: none;
    }
  }
</style>
