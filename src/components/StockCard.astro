---
import { formatCLP, formatKm } from '../scripts/utils';

interface Props {
  slug: string;
  marca: string;
  modelo: string;
  anio: number;
  km: number;
  precio: number;
  transmision: string;
  image: string;
}

const { slug, marca, modelo, anio, km, precio, transmision, image } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<a class="stock-card glass" href={`${base}auto/${slug}/`} data-tilt>
  <div class="stock-card__media">
    <img src={`${base}images/cars/${image}`} alt={`${marca} ${modelo} ${anio}`} loading="lazy" width="640" height="480" />
  </div>
  <div class="stock-card__body">
    <h3>{marca} {modelo}</h3>
    <p class="stock-card__meta">{anio} · {formatKm(km)} · {transmision}</p>
    <p class="price">{formatCLP(precio)}</p>
  </div>
</a>

<style>
  .stock-card {
    display: grid;
    grid-template-rows: 210px auto;
    color: inherit;
    transition: transform 0.25s var(--ease-out);
    text-decoration: none;
  }

  .stock-card__media {
    overflow: hidden;
  }

  .stock-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease-out);
  }

  .stock-card:hover .stock-card__media img {
    transform: scale(1.05);
  }

  .stock-card__body {
    padding: 1rem 1.1rem 1.2rem;
    display: grid;
    gap: 0.35rem;
  }

  .stock-card__body h3 {
    font-size: 1rem;
    letter-spacing: 0.06em;
  }

  .stock-card__meta {
    color: var(--text-muted);
    font-size: 0.88rem;
  }

  .price {
    margin-top: 0.25rem;
    font-size: 1.05rem;
  }
</style>
