---
const base = import.meta.env.BASE_URL;
---

<section class="hero" aria-label="Portada Valentino Dolusan">
  <div class="hero__media" aria-hidden="true">
    <img
      class="hero__photo"
      src={`${base}images/cars/hero-atmosphere.jpg`}
      alt=""
      width="1920"
      height="1080"
      fetchpriority="high"
    />
    <div class="hero__shade"></div>
    <canvas class="hero__canvas" id="hero-canvas"></canvas>
  </div>

  <div class="hero__content container">
    <img
      class="hero__logo"
      src={`${base}images/brand/logo-valentino.webp`}
      alt="Valentino Dolusan Automotriz"
      width="280"
      height="280"
    />
    <h1 class="hero__headline">Autos usados con presencia y respaldo</h1>
    <p class="hero__support">
      Selección cuidada, trato directo y acompañamiento claro desde la primera consulta.
    </p>
    <div class="cta-group hero__cta">
      <a class="btn btn-primary" href="#stock">Ver stock</a>
      <button class="btn btn-ghost" type="button" data-open-chat>Hablar con el asistente</button>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    padding: calc(var(--nav-h) + 1rem) 0 4.5rem;
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    filter: saturate(1.05) contrast(1.05);
  }

  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0.25) 35%, rgba(0, 0, 0, 0.82) 100%),
      radial-gradient(ellipse at 70% 40%, rgba(155, 0, 0, 0.25), transparent 55%);
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.55;
    pointer-events: none;
    mix-blend-mode: screen;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1rem;
    max-width: 720px;
  }

  .hero__logo {
    width: min(280px, 62vw);
    height: auto;
    filter: drop-shadow(0 12px 30px rgba(0, 0, 0, 0.55));
    animation: logo-in 1.1s var(--ease-out) both;
  }

  .hero__headline {
    font-size: clamp(1.85rem, 4.4vw, 3.2rem);
    max-width: 14ch;
    text-shadow: 0 8px 30px rgba(0, 0, 0, 0.55);
    animation: rise 1s 0.15s var(--ease-out) both;
  }

  .hero__support {
    max-width: 36ch;
    color: #d7d7d7;
    font-size: clamp(1rem, 2vw, 1.15rem);
    animation: rise 1s 0.28s var(--ease-out) both;
  }

  .hero__cta {
    margin-top: 0.5rem;
    animation: rise 1s 0.4s var(--ease-out) both;
  }

  @keyframes logo-in {
    from {
      opacity: 0;
      transform: translateY(18px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(22px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__logo,
    .hero__headline,
    .hero__support,
    .hero__cta {
      animation: none;
    }
  }
</style>

<script>
  import { initHero3D } from '../scripts/hero-3d.ts';
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
  if (canvas) {
    // Lazy: wait until idle / visible
    const start = () => initHero3D(canvas);
    if ('requestIdleCallback' in window) {
      (window as Window & { requestIdleCallback: (cb: () => void) => void }).requestIdleCallback(start);
    } else {
      setTimeout(start, 400);
    }
  }
</script>
